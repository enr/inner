#!/usr/bin/env bash
# End-to-end integration tests for inner.
#
# Usage:
#   ./.sdlc/e2e
#
# Requirements: inner in PATH, bwrap available, curl available in the sandbox.
# Run from any directory — the script uses absolute paths throughout.
#
# Exit code: 0 if all tests pass, 1 otherwise.

set -uo pipefail

# ── Helpers ───────────────────────────────────────────────────────────────────

PASS=0
FAIL=0
ERRORS=()

pass() { PASS=$((PASS + 1)); printf "  [PASS] %s\n" "$1"; }
fail() { FAIL=$((FAIL + 1)); ERRORS+=("$1"); printf "  [FAIL] %s\n" "$1"; }

section() { printf "\n── %s ──\n" "$1"; }

# run_sandbox: run inner with a profile file path, --no-interactive, plus extra flags.
run_sandbox() {
    local profile="$1"; shift
    inner run -p "$profile" --no-interactive "$@"
}

run_cmd() {
    local profile="$1"; shift
    local cmd="$1"; shift
    run_sandbox "$profile" "$@" -- -c "$cmd"
}

# dry_run: run inner --dry-run and emit stdout; extra flags are forwarded as-is.
# Does NOT add --no-interactive — callers control that when needed.
dry_run() {
    local profile="$1"; shift
    inner run -p "$profile" --dry-run "$@" 2>/dev/null
}

# bwrap_line: extract the bwrap command line from --dry-run output.
bwrap_line() {
    dry_run "$@" | awk '/^bwrap command:/{getline; print}'
}

# ── Setup: temporary profiles ─────────────────────────────────────────────────
# Profiles are written to a temp dir and passed by file path to inner run -p.
# No pollution of ~/.inner/profiles — the temp dir is the only thing to clean up.

TMPWORK=$(mktemp -d)
trap 'rm -rf "$TMPWORK"' EXIT

NONET="$TMPWORK/nonet.toml"
NET="$TMPWORK/net.toml"
GIT_PROF="$TMPWORK/git.toml"
CLAUDE="$TMPWORK/claude.toml"
INTERACTIVE="$TMPWORK/interactive.toml"  # interactive=true, for dry-run only
MOUNTS="$TMPWORK/mounts.toml"            # declared rw mount, for dry-run only
ROMOUNTS="$TMPWORK/romounts.toml"        # declared ro mount, for dry-run and runtime
CHILD="$TMPWORK/child.toml"              # extends $NONET, for profile show --resolved

cat > "$NONET" <<'EOF'
schema_version = "1"
name           = "inner-e2e-nonet"
description    = "e2e test profile — no network"

[sandbox]
network = false

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

cat > "$NET" <<'EOF'
schema_version = "1"
name        = "inner-e2e-net"
description = "e2e test profile — network enabled"

[sandbox]
network = true

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

cat > "$GIT_PROF" <<'EOF'
schema_version = "1"
name        = "inner-e2e-git"
description = "e2e test profile — git config sanitize"

[sandbox]
network = false

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15

[git]
strip_sections = ["credential"]

[git.overrides]
"user.email" = "inner-e2e-test@example.com"
EOF

cat > "$CLAUDE" <<'EOF'
schema_version = "1"
name           = "inner-e2e-claude"
description    = "e2e test profile — claude home sandboxing"
capabilities   = ["claude"]

[sandbox]
network = false

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

cat > "$INTERACTIVE" <<'EOF'
schema_version = "1"
name           = "inner-e2e-interactive"
description    = "e2e test profile — interactive (dry-run only)"

[sandbox]
network = false

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = true

[output]
timeout_seconds = 15
EOF

# Note: unquoted EOF so $TMPWORK is expanded into the TOML at write time.
cat > "$MOUNTS" <<EOF
schema_version = "1"
name           = "inner-e2e-mounts"
description    = "e2e test profile — declared rw mount (dry-run only)"

[sandbox]
network = false

[mounts]
"$TMPWORK" = { dest = "$TMPWORK", mode = "rw" }

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

# Note: unquoted EOF so $TMPWORK is expanded into the TOML at write time.
cat > "$ROMOUNTS" <<EOF
schema_version = "1"
name           = "inner-e2e-romounts"
description    = "e2e test profile — declared ro mount"

[sandbox]
network = false

[mounts]
"$TMPWORK" = { dest = "$TMPWORK", mode = "ro" }

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

# Note: unquoted EOF so $NONET is expanded into the TOML at write time.
cat > "$CHILD" <<EOF
schema_version = "1"
name           = "inner-e2e-child"
description    = "e2e test profile — extends nonet"
extends        = "$NONET"

[output]
timeout_seconds = 30
EOF

# ── Tests ─────────────────────────────────────────────────────────────────────

section "Working directory"

EXPECTED_WD="$TMPWORK"
ACTUAL_WD=$(run_sandbox "$NONET" -w "$TMPWORK" -- -c "pwd" 2>/dev/null || true)
ACTUAL_WD=$(echo "$ACTUAL_WD" | tr -d '[:space:]')
if [[ "$ACTUAL_WD" == "$EXPECTED_WD" ]]; then
    pass "-w absolute path: pwd inside sandbox matches"
else
    fail "-w absolute path: expected '$EXPECTED_WD', got '$ACTUAL_WD'"
fi

PARENT=$(cd "$TMPWORK/.." && pwd)
ACTUAL_WD=$(run_sandbox "$NONET" -w "$TMPWORK/.." -- -c "pwd" 2>/dev/null || true)
ACTUAL_WD=$(echo "$ACTUAL_WD" | tr -d '[:space:]')
if [[ "$ACTUAL_WD" == "$PARENT" ]]; then
    pass "-w relative path: resolved to absolute '$PARENT'"
else
    fail "-w relative path: expected '$PARENT', got '$ACTUAL_WD'"
fi

cd "$TMPWORK"
ACTUAL_WD=$(run_sandbox "$NONET" -- -c "pwd" 2>/dev/null || true)
ACTUAL_WD=$(echo "$ACTUAL_WD" | tr -d '[:space:]')
if [[ "$ACTUAL_WD" == "$TMPWORK" ]]; then
    pass "default workdir matches host cwd"
else
    fail "default workdir: expected '$TMPWORK', got '$ACTUAL_WD'"
fi
cd - > /dev/null

# ── Filesystem ────────────────────────────────────────────────────────────────

section "Filesystem"

MARKER="$TMPWORK/sandbox-wrote-this-$$"
run_sandbox "$NONET" -w "$TMPWORK" -- -c "touch sandbox-wrote-this-$$" 2>/dev/null || true
if [[ -f "$MARKER" ]]; then
    pass "cwd is writable: file created inside sandbox visible on host"
    rm -f "$MARKER"
else
    fail "cwd is writable: file not found on host after touch inside sandbox"
fi

if run_sandbox "$NONET" -- -c "touch /usr/bin/inner-e2e-probe 2>/dev/null" 2>/dev/null; then
    fail "/usr is read-only: write succeeded (should have been denied)"
else
    pass "/usr is read-only: write correctly denied"
fi

if run_sandbox "$NONET" -- -c "touch /etc/inner-e2e-probe 2>/dev/null" 2>/dev/null; then
    fail "/etc is read-only: write succeeded (should have been denied)"
else
    pass "/etc is read-only: write correctly denied"
fi

TMPFILE="/tmp/inner-e2e-isolation-$$"
run_sandbox "$NONET" -- -c "touch '$TMPFILE'" 2>/dev/null || true
if [[ -f "$TMPFILE" ]]; then
    fail "/tmp is isolated: file appeared on host (sandbox /tmp leaked)"
    rm -f "$TMPFILE"
else
    pass "/tmp is isolated: file in sandbox /tmp not visible on host"
fi

# $RODIR must be completely outside the cwd ($TMPWORK): inner adds the cwd
# --bind rw AFTER declared mounts, which would hide a ro-bind on any subdir.
RODIR=$(mktemp -d)
ROFILE="$RODIR/ro-target.txt"
echo "readonly-content" > "$ROFILE"
ROMOUNTS_RT="$TMPWORK/romounts-rt.toml"
cat > "$ROMOUNTS_RT" <<EOF
schema_version = "1"
name           = "inner-e2e-romounts-rt"

[sandbox]
network = false

[mounts]
"$RODIR" = { dest = "$RODIR", mode = "ro" }

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF
if run_sandbox "$ROMOUNTS_RT" -w "$TMPWORK" -- -c "echo modified > '$ROFILE'" 2>/dev/null; then
    fail "ro mount runtime: write to read-only mount succeeded (should be denied)"
else
    pass "ro mount runtime: write to read-only mount correctly denied"
fi
rm -rf "$RODIR"

# ro mount under workdir: inner should emit a warning because the workdir rw
# bind (emitted last by bwrap) silently shadows the declared ro subpath.
ROSUBDIR="$TMPWORK/ro-subdir-$$"
mkdir -p "$ROSUBDIR"
echo "readonly-content" > "$ROSUBDIR/ro-target.txt"
ROMOUNTS_WARN="$TMPWORK/romounts-warn.toml"
cat > "$ROMOUNTS_WARN" <<EOF
schema_version = "1"
name           = "inner-e2e-romounts-warn"

[sandbox]
network = false

[mounts]
"$ROSUBDIR" = { dest = "$ROSUBDIR", mode = "ro" }

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF
WARN_OUT=$(inner run -p "$ROMOUNTS_WARN" --no-interactive -w "$TMPWORK" -- -c true 2>/dev/null || true)
if echo "$WARN_OUT" | grep -q "warning:.*ro.*workdir\|warning:.*workdir.*ro"; then
    pass "ro mount under workdir: warning emitted"
else
    fail "ro mount under workdir: expected warning about ro mount under workdir, got: '$WARN_OUT'"
fi

# ── Network ───────────────────────────────────────────────────────────────────

section "Network"

if run_sandbox "$NONET" -- \
    -c "curl -s --connect-timeout 3 https://www.google.com -o /dev/null" 2>/dev/null; then
    fail "no-network profile: curl succeeded (should be blocked)"
else
    pass "no-network profile: curl correctly blocked"
fi

HTTP_CODE=$(run_sandbox "$NET" -- \
    -c "curl -s --connect-timeout 5 -o /dev/null -w '%{http_code}' https://www.google.com" \
    2>/dev/null || echo "000")
HTTP_CODE=$(echo "$HTTP_CODE" | tr -d '[:space:]')
if [[ "$HTTP_CODE" == "200" ]]; then
    pass "network-enabled profile: curl returned HTTP 200"
else
    fail "network-enabled profile: expected HTTP 200, got '$HTTP_CODE'"
fi

# ── Network allowlist mode ────────────────────────────────────────────────────
#
# The chain under test is namespace + bind-mounted socket + relay + proxy. Only
# a real bwrap can exercise it: everything below the socket is covered by unit
# tests, and everything above it only composes for real here.
#
# Note which assertions need the internet and which do not. Every DENIAL is
# decided before any name is resolved — that ordering is the whole point of the
# design, since resolving first would leak the name to the attacker's
# nameserver — so the refusal tests run offline. Only "an allowed domain is
# actually reachable" needs connectivity, and it is guarded.

section "Network: allowlist mode"

ALLOWLIST="$TMPWORK/allowlist.toml"
ALLOWLIST_LOCAL="$TMPWORK/allowlist-local.toml"
ALLOWLIST_DENY="$TMPWORK/allowlist-deny.toml"

cat > "$ALLOWLIST" <<'EOF'
schema_version = "1"
name        = "inner-e2e-allowlist"
description = "e2e test profile — network allowlist"

[sandbox]
network_mode  = "allowlist"
network_allow = ["example.com"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 30
EOF

# Deliberately lists the cloud metadata endpoint and host loopback in
# network_allow. Both must still be refused: the always-deny address list is not
# overridable by configuration, and this profile is what proves it.
cat > "$ALLOWLIST_LOCAL" <<'EOF'
schema_version = "1"
name        = "inner-e2e-allowlist-local"
description = "e2e test profile — always-deny beats the allow list"

[sandbox]
network_mode  = "allowlist"
network_allow = ["169.254.169.254", "127.0.0.1"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 30
EOF

# Allows and denies the same host: network_deny must win, which is what lets a
# profile drop a destination a capability contributed.
cat > "$ALLOWLIST_DENY" <<'EOF'
schema_version = "1"
name        = "inner-e2e-allowlist-deny"
description = "e2e test profile — network_deny overrides network_allow"

[sandbox]
network_mode  = "allowlist"
network_allow = ["example.com"]
network_deny  = ["example.com"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 30
EOF

# The socket is the only route out of the namespace, so its absence would make
# every other assertion below pass for the wrong reason.
OUT=$(run_cmd "$ALLOWLIST" 'test -S /tmp/inner/net-proxy.sock && echo SOCKET_OK' 2>/dev/null || true)
if echo "$OUT" | grep -q SOCKET_OK; then
    pass "allowlist: the proxy socket is bind-mounted inside the sandbox"
else
    fail "allowlist: the proxy socket is missing inside the sandbox"
fi

# All four spellings: Go checks the upper and lower case forms and other tools
# are split between them, so a missing one is a tool with silently no network.
OUT=$(run_cmd "$ALLOWLIST" 'echo "$HTTP_PROXY|$HTTPS_PROXY|$http_proxy|$https_proxy|$NODE_USE_ENV_PROXY|[$NO_PROXY]"' 2>/dev/null || true)
if echo "$OUT" | grep -q 'http://127.0.0.1:10108|http://127.0.0.1:10108|http://127.0.0.1:10108|http://127.0.0.1:10108|1|\[\]'; then
    pass "allowlist: every proxy environment variable is set, NO_PROXY forced empty"
else
    fail "allowlist: proxy environment is wrong (got '$OUT')"
fi

# The kernel guarantee underneath everything else: with --unshare-net there is
# no route and no resolver, so bypassing the proxy reaches nothing at all.
if run_cmd "$ALLOWLIST" 'curl -s --noproxy "*" --connect-timeout 5 -o /dev/null https://example.com' >/dev/null 2>&1; then
    fail "allowlist: a direct connection bypassing the proxy succeeded"
else
    pass "allowlist: a direct connection bypassing the proxy fails"
fi

# Refused before the name is ever resolved — no connectivity required.
OUT=$(run_cmd "$ALLOWLIST" 'curl -s --connect-timeout 10 -o /dev/null https://www.google.com' 2>&1 || true)
if echo "$OUT" | grep -q "blocked www.google.com:443 (not in the allow list)"; then
    pass "allowlist: a destination outside the list is refused, with the reason logged"
else
    fail "allowlist: expected a refusal for an unlisted destination (got '$OUT')"
fi

OUT=$(run_cmd "$ALLOWLIST_LOCAL" 'curl -s --connect-timeout 5 -o /dev/null http://169.254.169.254/' 2>&1 || true)
if echo "$OUT" | grep -q "cloud metadata endpoint"; then
    pass "allowlist: the cloud metadata endpoint is refused even when listed in network_allow"
else
    fail "allowlist: metadata endpoint was not refused by the always-deny list (got '$OUT')"
fi

# The proxy runs in the HOST network namespace, so without this check the
# sandbox would GAIN access to every service on the user's localhost.
OUT=$(run_cmd "$ALLOWLIST_LOCAL" 'curl -s --connect-timeout 5 -o /dev/null http://127.0.0.1:80/' 2>&1 || true)
if echo "$OUT" | grep -q "loopback address"; then
    pass "allowlist: host loopback is refused even when listed in network_allow"
else
    fail "allowlist: host loopback was not refused by the always-deny list (got '$OUT')"
fi

OUT=$(run_cmd "$ALLOWLIST_DENY" 'curl -s --connect-timeout 10 -o /dev/null https://example.com' 2>&1 || true)
if echo "$OUT" | grep -q 'denied by network_deny'; then
    pass "allowlist: network_deny overrides an explicit network_allow entry"
else
    fail "allowlist: network_deny did not override network_allow (got '$OUT')"
fi

# The one assertion that needs the internet: everything above is a refusal,
# and refusals are decided without resolving anything.
if curl -s --connect-timeout 5 -o /dev/null https://example.com 2>/dev/null; then
    HTTP_CODE=$(run_cmd "$ALLOWLIST" \
        "curl -s --connect-timeout 10 -o /dev/null -w '%{http_code}' https://example.com" 2>/dev/null || echo "000")
    HTTP_CODE=$(echo "$HTTP_CODE" | tr -d '[:space:]')
    if [[ "$HTTP_CODE" == "200" ]]; then
        pass "allowlist: an allowed destination is reachable through the proxy"
    else
        fail "allowlist: expected HTTP 200 for an allowed destination, got '$HTTP_CODE'"
    fi
else
    printf "  [SKIP] no internet access from the host, skipping the allowed-destination check\n"
fi

# `inner verify` builds the same sandbox a run gets, proxy included, and must
# still report the floor: no direct socket escapes the namespace.
if inner verify -p "$ALLOWLIST" 2>/dev/null | grep -q "network restricted"; then
    pass "allowlist: inner verify reports the network as restricted"
else
    fail "allowlist: inner verify did not report a restricted network"
fi

# With several layers feeding the list, the dry-run has to say which one
# contributed each entry, or "why is this domain open?" has no answer.
if [[ -d "$HOME/.claude" ]]; then
    CAP_ALLOW="$TMPWORK/allowlist-cap.toml"
    cat > "$CAP_ALLOW" <<'EOF'
schema_version = "1"
name         = "inner-e2e-allowlist-cap"
description  = "e2e test profile — capability egress defaults"
capabilities = ["claude"]

[sandbox]
network_mode  = "allowlist"
network_allow = ["example.com"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false
EOF
    OUT=$(dry_run "$CAP_ALLOW" -y)
    if echo "$OUT" | grep -qF "api.anthropic.com [capability:claude]" &&
       echo "$OUT" | grep -qF "example.com [profile]"; then
        pass "allowlist: the capability contributes its endpoints and the profile extends them"
    else
        fail "allowlist: layered allow list not reported with provenance (got '$OUT')"
    fi
else
    printf "  [SKIP] ~/.claude not found, skipping the capability-defaults check\n"
fi

# ── Environment variables ─────────────────────────────────────────────────────

section "Environment variables"

export INNER_E2E_HOSTVAR_$$="should-not-leak"
VAR_NAME="INNER_E2E_HOSTVAR_$$"
RESULT=$(run_sandbox "$NONET" -- -c "echo \${${VAR_NAME}:-NOTFOUND}" 2>/dev/null || true)
RESULT=$(echo "$RESULT" | tr -d '[:space:]')
if [[ "$RESULT" == "NOTFOUND" ]]; then
    pass "clearenv: host env var not visible inside sandbox"
else
    fail "clearenv: host env var leaked into sandbox (got '$RESULT')"
fi

RESULT=$(run_sandbox "$NONET" -e "INNER_E2E_INJECTED=hello" -- \
    -c 'echo ${INNER_E2E_INJECTED:-NOTFOUND}' 2>/dev/null || true)
RESULT=$(echo "$RESULT" | tr -d '[:space:]')
if [[ "$RESULT" == "hello" ]]; then
    pass "-e flag: injected env var visible inside sandbox"
else
    fail "-e flag: expected 'hello', got '$RESULT'"
fi

# ── Git config sanitization ───────────────────────────────────────────────────

section "Git config"

RESULT=$(run_sandbox "$GIT_PROF" -- -c "git config --list --global 2>/dev/null || true" 2>/dev/null || true)
if echo "$RESULT" | grep -qi "inner-e2e-test@example.com"; then
    pass "git config: injected override (user.email) visible inside sandbox"
else
    fail "git config: user.email override not found in git config --list output"
fi

if echo "$RESULT" | grep -qi "^credential"; then
    fail "git config: credential section was not stripped"
else
    pass "git config: credential section stripped from injected config"
fi

# ── ~/.claude sessions isolation ──────────────────────────────────────────────

section "~/.claude sandboxing"

CLAUDE_DIR="$HOME/.claude"

if [[ ! -d "$CLAUDE_DIR" ]]; then
    printf "  [SKIP] ~/.claude not found, skipping claude sandboxing tests\n"
else
    SENTINEL="inner-e2e-sentinel-$$.txt"
    SENTINEL_PATH="$CLAUDE_DIR/sessions/$SENTINEL"
    mkdir -p "$CLAUDE_DIR/sessions"
    echo "host-only" > "$SENTINEL_PATH"

    RESULT=$(run_sandbox "$CLAUDE" -y -- \
        -c "ls ~/.claude/sessions/ 2>/dev/null | wc -l | tr -d '[:space:]'" 2>/dev/null || echo "-1")
    RESULT=$(echo "$RESULT" | tr -d '[:space:]')
    if [[ "$RESULT" == "0" ]]; then
        pass "~/.claude/sessions: empty inside sandbox (real sessions not visible)"
    else
        fail "~/.claude/sessions: expected 0 entries inside sandbox, got '$RESULT'"
    fi

    run_sandbox "$CLAUDE" -y -- \
        -c "touch ~/.claude/sessions/sandbox-created-$$.txt" 2>/dev/null || true
    if [[ -f "$CLAUDE_DIR/sessions/sandbox-created-$$.txt" ]]; then
        fail "~/.claude/sessions: file created inside sandbox appeared on host"
    else
        pass "~/.claude/sessions: file created inside sandbox not visible on host"
    fi

    if [[ -f "$CLAUDE_DIR/.credentials.json" ]]; then
        RESULT=$(run_sandbox "$CLAUDE" -y -- \
            -c "test -f ~/.claude/.credentials.json && echo found || echo missing" \
            2>/dev/null || echo "missing")
        RESULT=$(echo "$RESULT" | tr -d '[:space:]')
        if [[ "$RESULT" == "found" ]]; then
            pass "~/.claude/.credentials.json: auth file visible inside sandbox"
        else
            fail "~/.claude/.credentials.json: auth file not visible inside sandbox"
        fi
    else
        printf "  [SKIP] ~/.claude/.credentials.json not found, skipping auth copy test\n"
    fi

    rm -f "$SENTINEL_PATH"
fi

# ── Extra arguments ───────────────────────────────────────────────────────────

section "Extra arguments"

RESULT=$(inner run -p "$NONET" --no-interactive -a "hello-from-arg" -- -c 'echo "$0"' 2>/dev/null || true)
RESULT=$(echo "$RESULT" | tr -d '[:space:]')
if [[ "$RESULT" == "hello-from-arg" ]]; then
    pass "--arg: value passed to entrypoint"
else
    fail "--arg: expected 'hello-from-arg', got '$RESULT'"
fi

RESULT=$(inner run -p "$NONET" --no-interactive -a "first" -a "second" -- -c 'echo "$0 $1"' 2>/dev/null || true)
RESULT=$(echo "$RESULT" | tr -d '[:space:]')
if [[ "$RESULT" == "firstsecond" ]]; then
    pass "--arg repeatable: both values passed to entrypoint"
else
    fail "--arg repeatable: expected 'firstsecond', got '$RESULT'"
fi

ISSUE_FILE="$TMPWORK/issue.md"
echo -n "fix the login bug" > "$ISSUE_FILE"
RESULT=$(inner run -p "$NONET" --no-interactive --args-file "$ISSUE_FILE" -- -c 'echo "$0"' 2>/dev/null || true)
RESULT=$(echo "$RESULT" | tr -d '\n')
if [[ "$RESULT" == "fix the login bug" ]]; then
    pass "--args-file: file content passed as single argument"
else
    fail "--args-file: expected 'fix the login bug', got '$RESULT'"
fi

MULTILINE_FILE="$TMPWORK/multiline.md"
printf "line one\nline two" > "$MULTILINE_FILE"
LINE_COUNT=$(inner run -p "$NONET" --no-interactive --args-file "$MULTILINE_FILE" -- -c 'printf "%s" "$0" | wc -l' 2>/dev/null || echo "0")
LINE_COUNT=$(echo "$LINE_COUNT" | tr -d '[:space:]')
if [[ "$LINE_COUNT" == "1" ]]; then
    pass "--args-file multiline: content passed as single arg (1 newline, 2 lines)"
else
    fail "--args-file multiline: expected 1 newline in single arg, wc -l returned '$LINE_COUNT'"
fi

# ── inner profile show ────────────────────────────────────────────────────────

section "inner profile show"

SHOW_OUT=$(inner profile show "$NONET" 2>/dev/null || true)
if echo "$SHOW_OUT" | grep -q "inner-e2e-nonet"; then
    pass "profile show: output contains profile name"
else
    fail "profile show: profile name not found in output"
fi

RESOLVED_OUT=$(inner profile show --resolved "$NONET" 2>/dev/null || true)
if echo "$RESOLVED_OUT" | grep -q "inner-e2e-nonet"; then
    pass "profile show --resolved: output contains profile name"
else
    fail "profile show --resolved: profile name not found in resolved output"
fi

EXPLAIN_OUT=$(inner profile show --explain "$CLAUDE" 2>/dev/null || true)
if echo "$EXPLAIN_OUT" | grep -qi "claude\|capability"; then
    pass "profile show --explain: capability explanation present"
else
    fail "profile show --explain: no capability explanation in output"
fi

if inner profile show "$TMPWORK/does-not-exist.toml" >/dev/null 2>&1; then
    fail "profile show: nonexistent profile should exit non-zero"
else
    pass "profile show: nonexistent profile correctly exits non-zero"
fi

section "inner profile show --resolved with extends"

RESOLVED=$(inner profile show --resolved "$CHILD" 2>/dev/null || true)
if echo "$RESOLVED" | grep -q "network.*=.*false"; then
    pass "profile show --resolved extends: inherited network=false from base"
else
    fail "profile show --resolved extends: network=false not found in resolved output"
fi
if echo "$RESOLVED" | grep -q "timeout_seconds.*=.*30"; then
    pass "profile show --resolved extends: child override timeout_seconds=30 present"
else
    fail "profile show --resolved extends: timeout_seconds override not found"
fi

# ── Dry-run: bwrap command verification ───────────────────────────────────────
# These tests inspect the bwrap command that inner would execute, without
# actually running the sandbox. They verify that flag decisions are correct
# at the configuration level.

section "Dry-run: network isolation"

LINE=$(bwrap_line "$NONET")
if echo "$LINE" | grep -q -- "--unshare-net"; then
    pass "no-network profile: --unshare-net present in bwrap command"
else
    fail "no-network profile: --unshare-net missing from bwrap command"
fi

LINE=$(bwrap_line "$NET")
if echo "$LINE" | grep -q -- "--unshare-net"; then
    fail "network-enabled profile: --unshare-net present (should be absent)"
else
    pass "network-enabled profile: --unshare-net correctly absent from bwrap command"
fi

section "Dry-run: process isolation"

# PID isolation is now ON by default for ALL runs (interactive included).
# Rationale: without --unshare-pid the sandbox shares the host PID namespace
# and can read /proc/<pid>/environ of same-UID host processes, leaking
# secrets. Verified that --unshare-pid alone keeps the controlling terminal,
# so TUI apps are unaffected (the TTY-breaking flag is --new-session, which
# inner never emits). Opt out per-profile with [sandbox] pid_namespace=false.

LINE=$(bwrap_line "$NONET")
if echo "$LINE" | grep -q -- "--unshare-pid"; then
    pass "non-interactive profile: --unshare-pid present in bwrap command"
else
    fail "non-interactive profile: --unshare-pid missing from bwrap command"
fi

# An interactive profile makes inner write shell-init.sh into its config dir
# (to inject PS1 through bash --init-file), so these two assertions need that
# directory to be writable. Where it is not — a read-only $HOME, or inner run
# from inside another sandbox — the dry-run fails and produces an EMPTY bwrap
# line, which would make the --new-session assertion below pass for the wrong
# reason: grep finds no --new-session in an empty string either.
INNER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/inner"
LINE=$(bwrap_line "$INTERACTIVE")
if [[ -z "$LINE" ]]; then
    if [[ -w "$INNER_CONFIG_DIR" ]]; then
        fail "interactive profile: dry-run produced no bwrap command"
    else
        printf "  [SKIP] %s is not writable, skipping interactive dry-run checks\n" "$INNER_CONFIG_DIR"
    fi
else
    # Interactive profile must now ALSO get PID isolation.
    if echo "$LINE" | grep -q -- "--unshare-pid"; then
        pass "interactive profile: --unshare-pid present (PID isolation on by default)"
    else
        fail "interactive profile: --unshare-pid missing (host /proc would leak)"
    fi

    # inner must NEVER emit --new-session: it calls setsid(), detaches the
    # controlling terminal, and makes TUI apps hang on open(/dev/tty) (ENXIO).
    if echo "$LINE" | grep -q -- "--new-session"; then
        fail "interactive profile: --new-session present (breaks TUI controlling terminal)"
    else
        pass "interactive profile: --new-session correctly absent"
    fi
fi

# Escape hatch: pid_namespace = false drops --unshare-pid.
NOPIDNS="$TMPWORK/nopidns.toml"
cat > "$NOPIDNS" <<'EOF'
schema_version = "1"
name = "inner-e2e-nopidns"

[sandbox]
network       = false
pid_namespace = false

[entrypoint]
cmd         = "/bin/bash"
interactive = true
EOF
LINE=$(bwrap_line "$NOPIDNS")
if echo "$LINE" | grep -q -- "--unshare-pid"; then
    fail "pid_namespace=false: --unshare-pid present (escape hatch ignored)"
else
    pass "pid_namespace=false: --unshare-pid correctly absent (escape hatch works)"
fi

section "Dry-run: environment"

LINE=$(bwrap_line "$NONET")
if echo "$LINE" | grep -q -- "--clearenv"; then
    pass "clearenv profile: --clearenv present in bwrap command"
else
    fail "clearenv profile: --clearenv missing from bwrap command"
fi

section "Dry-run: sensitive resource hiding"

if [[ -d "$HOME/.ssh" ]]; then
    LINE=$(bwrap_line "$NONET")
    if echo "$LINE" | grep -q -- "--tmpfs.*\.ssh\|\.ssh.*--tmpfs"; then
        pass "ssh-keys: --tmpfs $HOME/.ssh present in bwrap command"
    else
        # grep for the pattern more loosely
        if echo "$LINE" | grep -qF ".ssh"; then
            pass "ssh-keys: $HOME/.ssh referenced in bwrap command (hidden)"
        else
            fail "ssh-keys: $HOME/.ssh not hidden in bwrap command"
        fi
    fi
else
    printf "  [SKIP] ~/.ssh not found, skipping ssh-keys hiding test\n"
fi

if [[ -f "$HOME/.bash_history" ]]; then
    LINE=$(bwrap_line "$NONET")
    if echo "$LINE" | grep -qF ".bash_history"; then
        pass "bash-history: $HOME/.bash_history referenced in bwrap command (hidden)"
    else
        fail "bash-history: $HOME/.bash_history not hidden in bwrap command"
    fi
else
    printf "  [SKIP] ~/.bash_history not found, skipping bash-history hiding test\n"
fi

section "Dry-run: additional sensitive resource hiding"

for _item in \
    "gpg-keys:.gnupg:d" \
    "git-credentials:.git-credentials:f" \
    "netrc:.netrc:f" \
    "zsh-history:.zsh_history:f"
do
    _label="${_item%%:*}"; _rest="${_item#*:}"; _base="${_rest%%:*}"; _kind="${_rest##*:}"
    _path="$HOME/$_base"
    if { [[ "$_kind" == "d" ]] && [[ -d "$_path" ]]; } || \
       { [[ "$_kind" == "f" ]] && [[ -f "$_path" ]]; }; then
        _line=$(bwrap_line "$NONET")
        if echo "$_line" | grep -qF "$_base"; then
            pass "$_label: $_path referenced in bwrap command (hidden)"
        else
            fail "$_label: $_path not hidden in bwrap command"
        fi
    else
        printf "  [SKIP] %s not found, skipping %s hiding test\n" "$_path" "$_label"
    fi
done

section "Dry-run: capabilities"

if [[ -d "$HOME/.claude" ]]; then
    LINE=$(bwrap_line "$CLAUDE" -y)
    if echo "$LINE" | grep -qF ".claude"; then
        pass "claude capability: ~/.claude referenced in bwrap command"
    else
        fail "claude capability: ~/.claude not referenced in bwrap command"
    fi

    LINE_NOCAP=$(bwrap_line "$NONET")
    if echo "$LINE_NOCAP" | grep -qF ".claude"; then
        fail "no-capability profile: ~/.claude unexpectedly present in bwrap command"
    else
        pass "no-capability profile: ~/.claude correctly absent from bwrap command"
    fi
else
    printf "  [SKIP] ~/.claude not found, skipping claude capability dry-run\n"
fi

section "Dry-run: declared mounts"

LINE=$(bwrap_line "$MOUNTS")
if echo "$LINE" | grep -qF -- "--bind $TMPWORK $TMPWORK"; then
    pass "rw mount: --bind $TMPWORK $TMPWORK present in bwrap command"
else
    fail "rw mount: --bind $TMPWORK $TMPWORK missing from bwrap command"
fi

LINE=$(bwrap_line "$ROMOUNTS")
if echo "$LINE" | grep -qF -- "--ro-bind $TMPWORK $TMPWORK"; then
    pass "ro mount: --ro-bind $TMPWORK $TMPWORK present in bwrap command"
else
    fail "ro mount: --ro-bind $TMPWORK $TMPWORK missing from bwrap command"
fi

# Verify rw mount does not use --ro-bind
LINE=$(bwrap_line "$MOUNTS")
if echo "$LINE" | grep -qF -- "--ro-bind $TMPWORK $TMPWORK"; then
    fail "rw mount: --ro-bind found instead of --bind"
else
    pass "rw mount: --bind used (not --ro-bind)"
fi

section "Dry-run: working directory"

LINE=$(bwrap_line "$NONET" -w "$TMPWORK")
if echo "$LINE" | grep -qF -- "--chdir $TMPWORK"; then
    pass "-w flag: --chdir $TMPWORK present in bwrap command"
else
    fail "-w flag: --chdir $TMPWORK missing from bwrap command"
fi

# ── inner verify — default profiles ──────────────────────────────────────────
# Paths point directly to sources so the latest version is always validated.

section "inner verify — default profiles"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROFILES_DIR="$SCRIPT_DIR/../internal/setup/profiles"
CONTRIB_DIR="$SCRIPT_DIR/../contrib/profiles"
PODMAN_SOCK="/run/user/$(id -u)/podman/podman.sock"

# run_verify: run `inner verify` on a profile and report. On failure the failing
# check lines are printed: without them "verify <profile>" is an unactionable
# red line, and the interesting information (which check, on which path) is
# exactly what the report should carry.
run_verify() {
    local label="$1" path="$2" out
    out=$(inner verify -p "$path" 2>&1)
    if [[ $? -eq 0 ]]; then
        pass "verify $label"
        return
    fi
    fail "verify $label"
    echo "$out" | grep -A1 "^\[!!\]" | sed 's/^/         /'
}

run_verify "shell"         "$PROFILES_DIR/shell.toml"
run_verify "shell-oneshot" "$PROFILES_DIR/shell-oneshot.toml"

if [[ -d "$HOME/.claude" ]]; then
    run_verify "claude-interactive" "$PROFILES_DIR/claude-interactive.toml"
    run_verify "claude-one-shot"    "$PROFILES_DIR/claude-one-shot.toml"
    run_verify "shell-with-claude"  "$CONTRIB_DIR/shell-with-claude.toml"
else
    printf "  [SKIP] ~/.claude not found, skipping claude profile verify\n"
fi

if [[ -d "$HOME/.gemini" ]]; then
    run_verify "gemini-interactive" "$PROFILES_DIR/gemini-interactive.toml"
    run_verify "gemini-one-shot"    "$PROFILES_DIR/gemini-one-shot.toml"
else
    printf "  [SKIP] ~/.gemini not found, skipping gemini profile verify\n"
fi

if [[ -S "$PODMAN_SOCK" ]]; then
    run_verify "shell-containers" "$CONTRIB_DIR/shell-containers.toml"
    if [[ -d "$HOME/.claude" ]]; then
        run_verify "claude-containers" "$CONTRIB_DIR/claude-containers.toml"
    else
        printf "  [SKIP] ~/.claude not found, skipping claude-containers verify\n"
    fi
else
    printf "  [SKIP] podman socket not available, skipping container profile verify\n"
fi

# ── Planted-secret confidentiality tests ─────────────────────────────────────
# The read side of the sandbox (SECURITY_REVIEW.md issue #1). Two policies are
# asserted against a REAL bwrap, with real files planted on the host:
#
#   home = "host-ro" (default) → denylist: the paths in config.SensitiveResources
#                                are hidden, everything else in $HOME is readable.
#   home = "isolated"          → allowlist: $HOME is an empty tmpfs, so a planted
#                                secret is invisible wherever it sits.
#
# Everything planted here is removed by cleanup_planted, including directories
# that did not exist before this run. The whole section is skipped when $HOME is
# not writable (e.g. when this script itself runs inside an inner sandbox).

section "Planted secrets: read-side policy"

PLANTED_FILES=()
PLANTED_DIRS=()
PLANTED_CONTENT="inner-e2e-planted-secret-$$"

# plant: create a file with known content, remembering what to remove later.
# Usage: plant <abs-path>
plant() {
    local target="$1" dir
    dir=$(dirname "$target")
    if [[ ! -d "$dir" ]]; then
        mkdir -p "$dir" || return 1
        PLANTED_DIRS+=("$dir")
    fi
    echo "$PLANTED_CONTENT" > "$target" || return 1
    PLANTED_FILES+=("$target")
}

cleanup_planted() {
    local f d i
    for f in "${PLANTED_FILES[@]:-}"; do [[ -n "$f" ]] && rm -f "$f"; done
    # Deepest last-created first, and only if empty: never remove a pre-existing tree.
    for ((i = ${#PLANTED_DIRS[@]} - 1; i >= 0; i--)); do
        d="${PLANTED_DIRS[$i]}"
        [[ -n "$d" ]] && rmdir "$d" 2>/dev/null
    done
    return 0
}
trap 'rm -rf "$TMPWORK"; cleanup_planted' EXIT

# read_in_sandbox: cat a host path inside the sandbox; prints the content or
# "UNREADABLE". Runs from $TMPWORK so the workdir bind never re-exposes $HOME.
read_in_sandbox() {
    local profile="$1" target="$2"
    run_sandbox "$profile" -w "$TMPWORK" -- \
        -c "cat '$target' 2>/dev/null || echo UNREADABLE" 2>/dev/null | tr -d '[:space:]'
}

planted_secret_tests() {
    # A secret on the deny list, a secret NOT on it, both inside $HOME.
    local denied="$HOME/.config/gh/inner-e2e-hosts-$$.yml"
    local unlisted="$HOME/.inner-e2e-unlisted-secret-$$.env"
    local allowed_dir="$HOME/.inner-e2e-allowed-$$"
    plant "$denied"          || { fail "planted secrets: cannot create $denied"; return; }
    plant "$unlisted"        || { fail "planted secrets: cannot create $unlisted"; return; }
    plant "$allowed_dir/tool.txt" || { fail "planted secrets: cannot create $allowed_dir"; return; }

    local isolated="$TMPWORK/isolated.toml"
    cat > "$isolated" <<'EOF'
schema_version = "1"
name           = "inner-e2e-isolated"
description    = "e2e test profile — isolated home (allowlist)"

[sandbox]
network = false
home    = "isolated"

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

    local isolated_allow="$TMPWORK/isolated-allow.toml"
    cat > "$isolated_allow" <<EOF
schema_version = "1"
name           = "inner-e2e-isolated-allow"

[sandbox]
network    = false
home       = "isolated"
home_allow = ["$allowed_dir"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

    local gh_allowed="$TMPWORK/gh-allowed.toml"
    cat > "$gh_allowed" <<'EOF'
schema_version = "1"
name           = "inner-e2e-gh-allowed"

[sandbox]
network = false
allow   = ["gh-config"]

[env]
clearenv = true
inherit  = ["HOME", "USER", "PATH", "SHELL", "TERM", "LANG"]

[entrypoint]
cmd         = "/bin/bash"
interactive = false

[output]
timeout_seconds = 15
EOF

    local result

    # 1. Deny list, host-ro: the hide entry must actually hide the path.
    result=$(read_in_sandbox "$NONET" "$denied")
    if [[ "$result" == "UNREADABLE" ]]; then
        pass "host-ro: planted ~/.config/gh secret is not readable (deny list covers it)"
    else
        fail "host-ro: planted ~/.config/gh secret was READ inside the sandbox (got '$result')"
    fi

    # 2. Deny list, host-ro: a path nobody listed IS readable. This is the known
    #    weakness of the denylist model, asserted so it cannot change silently.
    result=$(read_in_sandbox "$NONET" "$unlisted")
    if [[ "$result" == "$PLANTED_CONTENT" ]]; then
        pass "host-ro: unlisted secret is readable (documented denylist limitation)"
    else
        fail "host-ro: expected the unlisted secret to be readable, got '$result'"
    fi

    # 3. The allow key un-hides a deny-list path again (escape hatch works).
    result=$(read_in_sandbox "$gh_allowed" "$denied")
    if [[ "$result" == "$PLANTED_CONTENT" ]]; then
        pass "host-ro: allow = [\"gh-config\"] re-exposes ~/.config/gh"
    else
        fail "host-ro: allow = [\"gh-config\"] did not re-expose ~/.config/gh (got '$result')"
    fi

    # 4. Isolated home: BOTH secrets disappear — that is the point of the allowlist.
    result=$(read_in_sandbox "$isolated" "$denied")
    if [[ "$result" == "UNREADABLE" ]]; then
        pass "isolated: planted ~/.config/gh secret is not readable"
    else
        fail "isolated: planted ~/.config/gh secret was READ inside the sandbox (got '$result')"
    fi

    result=$(read_in_sandbox "$isolated" "$unlisted")
    if [[ "$result" == "UNREADABLE" ]]; then
        pass "isolated: unlisted secret is not readable (allowlist model holds)"
    else
        fail "isolated: unlisted secret was READ inside the sandbox (got '$result')"
    fi

    # 5. Isolated home really is a tmpfs.
    result=$(run_sandbox "$isolated" -w "$TMPWORK" -- \
        -c 'findmnt -no FSTYPE "$HOME" 2>/dev/null || grep -c " $HOME tmpfs " /proc/self/mountinfo' \
        2>/dev/null | tr -d '[:space:]')
    if [[ "$result" == "tmpfs" || "$result" == "1" ]]; then
        pass "isolated: \$HOME is a tmpfs inside the sandbox"
    else
        fail "isolated: \$HOME is not a tmpfs (got '$result')"
    fi

    # 6. inner verify agrees: the home-isolated check passes for this profile.
    if inner verify -p "$isolated" >/dev/null 2>&1; then
        pass "isolated: inner verify passes (home-isolated check)"
    else
        fail "isolated: inner verify failed for the isolated-home profile"
    fi

    # 7. The allowlist re-exposes what the profile asks for, and only that.
    result=$(read_in_sandbox "$isolated_allow" "$allowed_dir/tool.txt")
    if [[ "$result" == "$PLANTED_CONTENT" ]]; then
        pass "isolated: home_allow entry is readable inside the sandbox"
    else
        fail "isolated: home_allow entry not readable (got '$result')"
    fi

    result=$(read_in_sandbox "$isolated_allow" "$unlisted")
    if [[ "$result" == "UNREADABLE" ]]; then
        pass "isolated: home_allow does not re-expose the rest of the home"
    else
        fail "isolated: unlisted secret readable despite the allowlist (got '$result')"
    fi
}

HOME_PROBE="$HOME/.inner-e2e-writable-$$"
if touch "$HOME_PROBE" 2>/dev/null; then
    rm -f "$HOME_PROBE"
    planted_secret_tests
else
    printf "  [SKIP] \$HOME is not writable (running inside a sandbox?), skipping planted-secret tests\n"
fi

# ── Summary ───────────────────────────────────────────────────────────────────

printf "\n────────────────────────────────\n"
printf "Result: %d passed, %d failed\n" "$PASS" "$FAIL"

if [[ "${#ERRORS[@]}" -gt 0 ]]; then
    printf "\nFailed tests:\n"
    for e in "${ERRORS[@]}"; do
        printf "  - %s\n" "$e"
    done
    exit 1
fi

exit 0
